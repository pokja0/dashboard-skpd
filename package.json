{
  "name": "dashboard-opd-sulbar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "data:build": "python scripts/build_data.py",
    "data:sync": "python scripts/sync_sheet.py",
    "data:sync:build": "python scripts/sync_sheet.py && bun run build",
    "data:watch": "python scripts/sync_sheet.py --watch --interval 300",
    "start": "bun build/index.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "xlsx-js-style": "^1.2.0"
  }
}
